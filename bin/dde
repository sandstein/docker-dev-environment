# :command.user_hooks
before_hook() {
  # src/before.sh
  # Runs after the arguments were parsed, before the command: loads the dde wide
  # settings (.env in the dde home) and the project settings (.env.dde,
  # searched upwards from $PWD). `dde init` works without them.

  if [[ "${action}" != "init" ]]; then
      load_settings
  fi

}

# :command.initialize
initialize() {
  declare -g version="1.0.0"
  set -e

  # src/initialize.sh
  # Runs before the arguments are parsed. Settings are loaded later in before.sh.

  shopt -s extglob

  SCRIPT_PATH="$(readlink -f "$0")"

  # The dde home is the directory containing bin/dde (symlinks resolved).
  DDE_HOME="$(dirname "$(dirname "${SCRIPT_PATH}")")"
  DDE_COMPOSE_FILE="${DDE_HOME}/docker-compose.yml"
  DDE_VHOSTS_TARGET="/var/www/vhosts"

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a other_args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"
  before_hook

  case "$action" in
    "up") dde_up_command ;;
    "stop") dde_stop_command ;;
    "down") dde_down_command ;;
    "restart") dde_restart_command ;;
    "build") dde_build_command ;;
    "exec") dde_exec_command ;;
    "run") dde_run_command ;;
    "shell") dde_shell_command ;;
    "logs") dde_logs_command ;;
    "ps") dde_ps_command ;;
    "ls") dde_ls_command ;;
    "get") dde_get_command ;;
    "get services") dde_get_services_command ;;
    "get containers") dde_get_containers_command ;;
    "compose") dde_compose_command ;;
    "config") dde_config_command ;;
    "list") dde_list_command ;;
    "migrate") dde_migrate_command ;;
    "version") dde_version_command ;;
    "init") dde_init_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
