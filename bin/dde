dde_usage() {
  printf "dde - Docker dev environment - versioned service containers for local development\n\n"

  printf "%s\n" "Usage:"
  printf "  dde COMMAND\n"
  printf "  dde [COMMAND] --help | -h\n"
  printf "  dde --version | -v\n"
  echo
  # :command.usage_commands
  printf "%s\n" "Commands:"
  printf "  %s   Create and start containers (default - DOCKER_CONTAINER from .env.dde)\n" "up     "
  printf "  %s   Stop containers without removing them (default - DOCKER_CONTAINER from .env.dde)\n" "stop   "
  printf "  %s   Stop and remove containers (default - DOCKER_CONTAINER from .env.dde). Never removes data.\n" "down   "
  printf "  %s   Restart containers (default - DOCKER_CONTAINER from .env.dde)\n" "restart"
  printf "  %s   Build or rebuild images (default - DOCKER_CONTAINER from .env.dde)\n" "build  "
  printf "  %s   Execute a command in a running container\n" "exec   "
  printf "  %s   Run a one-off command in a new container (docker compose run --rm)\n" "run    "
  printf "  %s   Open an interactive shell (bash, or sh if bash is missing) in a running container\n" "shell  "
  printf "  %s   Show container output (default - DOCKER_CONTAINER from .env.dde)\n" "logs   "
  printf "  %s   List the containers of this project and their state (same as dde get containers)\n" "ps     "
  printf "  %s   List all services dde can start (same as dde get services)\n" "ls     "
  printf "  %s   Display resources\n" "get    "
  printf "  %s   Run any docker compose command against the dde compose file\n" "compose"
  printf "  %s   Show the resolved settings for the current directory\n" "config "
  printf "  %s   List the dde commands\n" "list   "
  printf "  %s   Remove the named volumes dde 0.x used for its bind mounts.\n" "migrate"
  printf "  %s   Show version information\n" "version"
  printf "  %s   Hook dde into your shell (PATH and completions). Run once after cloning.\n" "init   "
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
