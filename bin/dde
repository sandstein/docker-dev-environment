# :command.normalize_input
# :command.normalize_input_function
normalize_input() {
  local arg passthru
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

# :command.inspect_args
inspect_args() {
  local k

  if ((${#args[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!args[@]}" | sort)
    echo args:
    for k in "${sorted_keys[@]}"; do
      echo "- \${args[$k]} = ${args[$k]}"
    done
  else
    echo args: none
  fi

  if ((${#other_args[@]})); then
    echo
    echo other_args:
    echo "- \${other_args[*]} = ${other_args[*]}"
    for k in "${!other_args[@]}"; do
      echo "- \${other_args[$k]} = ${other_args[$k]}"
    done
  fi

  if ((${#deps[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!deps[@]}" | sort)
    echo
    echo deps:
    for k in "${sorted_keys[@]}"; do
      echo "- \${deps[$k]} = ${deps[$k]}"
    done
  fi

  if ((${#env_var_names[@]})); then
    readarray -t sorted_names < <(printf '%s\n' "${env_var_names[@]}" | sort)
    echo
    echo "environment variables:"
    for k in "${sorted_names[@]}"; do
      echo "- \$$k = ${!k:-}"
    done
  fi
}

# :command.user_lib
# src/lib/colors.sh
print_in_color() {
  local color="$1"
  shift
  if [[ -z ${NO_COLOR+x} ]]; then
    printf "$color%b\e[0m\n" "$*";
  else
    printf "%b\n" "$*";
  fi
}

red() { print_in_color "\e[31m" "$*"; }
green() { print_in_color "\e[32m" "$*"; }
yellow() { print_in_color "\e[33m" "$*"; }
blue() { print_in_color "\e[34m" "$*"; }
magenta() { print_in_color "\e[35m" "$*"; }
cyan() { print_in_color "\e[36m" "$*"; }
bold() { print_in_color "\e[1m" "$*"; }
underlined() { print_in_color "\e[4m" "$*"; }
red_bold() { print_in_color "\e[1;31m" "$*"; }
green_bold() { print_in_color "\e[1;32m" "$*"; }
yellow_bold() { print_in_color "\e[1;33m" "$*"; }
blue_bold() { print_in_color "\e[1;34m" "$*"; }
magenta_bold() { print_in_color "\e[1;35m" "$*"; }
cyan_bold() { print_in_color "\e[1;36m" "$*"; }
red_underlined() { print_in_color "\e[4;31m" "$*"; }
green_underlined() { print_in_color "\e[4;32m" "$*"; }
yellow_underlined() { print_in_color "\e[4;33m" "$*"; }
blue_underlined() { print_in_color "\e[4;34m" "$*"; }
magenta_underlined() { print_in_color "\e[4;35m" "$*"; }
cyan_underlined() { print_in_color "\e[4;36m" "$*"; }

# src/lib/compose.sh
# Helpers around docker compose and the services of the current project.

# Runs docker compose against the dde compose file.
compose() {
    local -a cmd
    read -ra cmd <<< "${DOCKER_COMPOSE_COMMAND}"
    "${cmd[@]}" -f "${DDE_COMPOSE_FILE}" "$@"
}

# Fills the array SERVICES from the command's (repeatable) service
# argument, splitting on spaces and commas. Without it DOCKER_CONTAINER from
# .env.dde is used.
resolve_services() {
    local list
    local -a given=()
    # bashly stores repeatable arguments as a quoted, space separated string
    eval "given=(${args[service]:-})"
    if (( ${#given[@]} )); then
        list="${given[*]}"
    else
        list="${DOCKER_CONTAINER:-}"
    fi
    read -ra SERVICES <<< "${list//,/ }"
    if (( ${#SERVICES[@]} == 0 )); then
        fail "no service given and DOCKER_CONTAINER is not set$(project_hint)"
    fi
}

# Prints the service given explicitly ($1) or DEFAULT_CONTAINER.
resolve_service() {
    if [[ -n "${1:-}" ]]; then
        printf '%s\n' "$1"
    elif [[ -n "${DEFAULT_CONTAINER:-}" ]]; then
        printf '%s\n' "${DEFAULT_CONTAINER}"
    else
        fail "no service given (-s) and DEFAULT_CONTAINER is not set$(project_hint)"
    fi
}

project_hint() {
    if [[ -z "${DDE_PROJECT_ENV:-}" ]]; then
        printf ' (no .env.dde found in %s or its parents)' "${PWD}"
    else
        printf ' (in %s)' "${DDE_PROJECT_ENV}"
    fi
}

# Prints the line of compose/services.tsv (generated) for service $1:
# service <TAB> mounts vhosts (0|1) <TAB> host dirs (':' separated)
service_info() {
    local file="${DDE_HOME}/compose/services.tsv"
    [[ -f "${file}" ]] || return 1
    awk -F '\t' -v service="$1" '$1 == service { print; found = 1 } END { exit !found }' "${file}"
}

# Succeeds if the service mounts the projects directory (vhosts). Services
# missing in services.tsv are looked up in the resolved compose config.
service_mounts_vhosts() {
    local info
    if info="$(service_info "$1")"; then
        [[ "$(cut -f2 <<< "${info}")" == "1" ]]
    else
        compose config "$1" 2>/dev/null | grep -q "target: ${DDE_VHOSTS_TARGET}\$"
    fi
}

# Prints the container path of the current directory, or nothing if it is
# not below the dde vhosts directory.
container_workdir() {
    if [[ -n "${PROJECT_ROOT:-}" ]]; then
        printf '%s/%s\n' "${DDE_VHOSTS_TARGET}" "${PROJECT_ROOT}"
        return
    fi
    local vhosts pwd_real
    vhosts="$(realpath "${DDE_HOME}/vhosts" 2>/dev/null)" || return 0
    pwd_real="$(realpath "${PWD}")"
    if [[ "${pwd_real}" == "${vhosts}" ]]; then
        printf '%s\n' "${DDE_VHOSTS_TARGET}"
    elif [[ "${pwd_real}" == "${vhosts}/"* ]]; then
        printf '%s/%s\n' "${DDE_VHOSTS_TARGET}" "${pwd_real#"${vhosts}/"}"
    fi
}

# Fills the array WORKDIR_ARGS for running in service $1. An explicit
# directory ($2) wins; services without the projects mount get none.
resolve_workdir_args() {
    local service="$1" explicit="${2:-}" dir
    WORKDIR_ARGS=()
    if [[ -n "${explicit}" ]]; then
        WORKDIR_ARGS=(-w "${explicit}")
        return
    fi
    service_mounts_vhosts "${service}" || return 0
    dir="$(container_workdir)"
    if [[ -n "${dir}" ]]; then
        WORKDIR_ARGS=(-w "${dir}")
    else
        note "${PWD} is not below ${DDE_HOME}/vhosts, using the container's default working directory"
    fi
}

# Parses docker style options of dde exec / dde run. Everything from the
# first non-option on is the command.
#   EXEC_SERVICE, EXEC_USER, EXEC_WORKDIR, EXEC_TTY (0/1), EXEC_ENV (array),
#   EXEC_COMMAND (array)
parse_exec_options() {
    EXEC_SERVICE=""
    EXEC_USER=""
    EXEC_WORKDIR=""
    EXEC_TTY=1
    EXEC_ENV=()
    EXEC_COMMAND=()
    while (( $# )); do
        case "$1" in
            -s|--service|-u|--user|-w|--workdir|-e|--env)
                (( $# >= 2 )) || fail "option $1 needs a value"
                case "$1" in
                    -s|--service) EXEC_SERVICE="$2" ;;
                    -u|--user) EXEC_USER="$2" ;;
                    -w|--workdir) EXEC_WORKDIR="$2" ;;
                    -e|--env) EXEC_ENV+=(-e "$2") ;;
                esac
                shift 2
                ;;
            --service=*) EXEC_SERVICE="${1#*=}"; shift ;;
            --user=*) EXEC_USER="${1#*=}"; shift ;;
            --workdir=*) EXEC_WORKDIR="${1#*=}"; shift ;;
            --env=*) EXEC_ENV+=(-e "${1#*=}"); shift ;;
            -T|--no-tty) EXEC_TTY=0; shift ;;
            --) shift; break ;;
            -*) fail "unknown option $1 (dde options must come before the command)" ;;
            *) break ;;
        esac
    done
    EXEC_COMMAND=("$@")
    (( ${#EXEC_COMMAND[@]} )) || fail "no command given"
}

# Builds the common docker compose exec/run arguments into RUN_ARGS and
# prints nothing. Uses the EXEC_* variables from parse_exec_options.
build_run_args() {
    local service
    service="$(resolve_service "${EXEC_SERVICE}")" || exit 1
    resolve_workdir_args "${service}" "${EXEC_WORKDIR}"
    RUN_ARGS=()
    if (( EXEC_TTY == 0 )) || [[ ! -t 0 ]]; then
        RUN_ARGS+=(-T)
    fi
    RUN_ARGS+=(-u "${EXEC_USER:-${USER_ID}}")
    RUN_ARGS+=("${WORKDIR_ARGS[@]}" "${EXEC_ENV[@]}" "${service}" "${EXEC_COMMAND[@]}")
}

# src/lib/init.sh
# Helpers for dde init.

# Writes ~/.docker/.dderc, which puts dde on the PATH and loads completions.
write_dderc() {
    mkdir -p "${HOME}/.docker"
    cat > "${HOME}/.docker/.dderc" <<EOL
# docker dev environment, written by dde init
export DOCKER_DEV_ENVIRONMENT_HOME="${DDE_HOME}"
case ":\${PATH}:" in
    *":\${DOCKER_DEV_ENVIRONMENT_HOME}/bin:"*) ;;
    *) PATH="\${DOCKER_DEV_ENVIRONMENT_HOME}/bin:\${PATH}" ;;
esac
if [ -n "\${ZSH_VERSION:-}" ]; then
    autoload -U +X bashcompinit && bashcompinit
fi
if [ -f "\${DOCKER_DEV_ENVIRONMENT_HOME}/bin/completions.bash" ]; then
    . "\${DOCKER_DEV_ENVIRONMENT_HOME}/bin/completions.bash"
fi
EOL
}

# Appends the source line for .dderc to the given rc file once.
hook_rc_file() {
    local rc_file="$1"
    [[ -f "${rc_file}" ]] || return 1
    if ! grep -qF ".docker/.dderc" "${rc_file}"; then
        printf '\n# docker dev environment\nsource ~/.docker/.dderc\n' >> "${rc_file}"
        note "added dde to ${rc_file}"
    fi
    return 0
}

# src/lib/listing.sh
# Output of dde ls / dde ps.

# Prints all services, optionally filtered by a substring.
list_services() {
    local filter="${1:-}"
    compose config --services | sort -V | grep -F -- "${filter}" || true
}

# Prints the project's containers (or all existing dde containers with
# $1 set) with their state.
list_containers() {
    local all="${1:-}" service state
    local -A states=()
    local -a services=()
    while IFS=$'\t' read -r service state; do
        [[ -n "${service}" ]] && states["${service}"]="${state}"
    done < <(compose ps -a --format '{{.Service}}\t{{.Status}}' 2>/dev/null)

    if [[ -n "${all}" ]]; then
        mapfile -t services < <(printf '%s\n' "${!states[@]}" | sort -V)
    else
        resolve_services
        services=("${SERVICES[@]}")
    fi

    printf '%-24s %-8s %s\n' SERVICE DEFAULT STATUS
    for service in "${services[@]}"; do
        [[ -n "${service}" ]] || continue
        printf '%-24s %-8s %s\n' "${service}" \
            "$([[ "${service}" == "${DEFAULT_CONTAINER:-}" ]] && echo yes)" \
            "${states[${service}]:-not created}"
    done
}

# src/lib/output.sh
# Messages go to stderr so stdout stays usable in pipes.

warn() {
    yellow "Warning: $*" >&2
}

note() {
    cyan "$*" >&2
}

fail() {
    red "Error: $*" >&2
    exit 1
}

# src/lib/prepare.sh
# Runs before a service starts: creates its mount directories and missing
# configuration files from their samples, so the bind mounts exist and
# belong to the user (compose is told not to create them as root).

# Directory the compose files mount from (DOCKER_VOLUME_BASE_PATH).
volume_base() {
    printf '%s\n' "${DOCKER_VOLUME_BASE_PATH:-${DDE_HOME}}"
}

prepare_service() {
    local service="$1"
    create_mount_dirs "${service}"
    create_config "${service}"
}

# Creates the host directories listed for the service in services.tsv.
# Only possible when the docker daemon runs on this machine.
create_mount_dirs() {
    local service="$1" info dirs dir base
    info="$(service_info "${service}")" || return 0
    dirs="$(cut -f3 <<< "${info}")"
    [[ -n "${dirs}" ]] || return 0
    if [[ -n "${DOCKER_HOST:-}" && "${DOCKER_HOST}" != unix://* ]]; then
        return 0
    fi
    base="$(volume_base)"
    while IFS= read -r -d ':' dir; do
        if [[ ! -d "${base}/${dir}" ]]; then
            note "${service}: creating ${base}/${dir}"
            mkdir -p "${base}/${dir}" || fail "could not create ${base}/${dir}"
        fi
    done <<< "${dirs}:"
}

# Copies sample configuration into place on first start.
create_config() {
    local service="$1" config_file=""
    local sample="${DDE_HOME}/config/${service}"
    local config
    config="$(volume_base)/config/${service}"

    case "${service}" in
        php-*) config_file="${config}/etc/php/php.ini" ;;
        mysql-*|percona-*|mariadb-*) config_file="${config}/etc/my.cnf" ;;
        ssh) config_file="${config}/tunnel.conf" ;;
        nginx-*) config_file="${config}/etc/nginx/conf.d/default.conf" ;;
        varnish-*) config_file="${config}/etc/varnish/default.vcl" ;;
        opensearch-*) config_file="${config}/config/opensearch.yml" ;;
    esac

    if [[ -z "${config_file}" || -f "${config_file}" ]]; then
        return 0
    fi

    case "${service}" in
        php-*)
            note "${service}: copying sample php.ini and conf.d/*.ini, adapt them to your needs"
            mkdir -p "${config}/etc/php/conf.d"
            cp "${sample}/sample/conf.d/"*.ini "${config}/etc/php/conf.d/"
            cp "${sample}/sample/php.ini.sample" "${config_file}"
            ;;
        nginx-*)
            note "${service}: copying sample default.conf, adapt it to your needs"
            mkdir -p "$(dirname "${config_file}")"
            cp "${sample}/sample/conf.d/default.conf" "${config_file}"
            ;;
        varnish-*)
            note "${service}: copying sample default.vcl, adapt it to your needs"
            mkdir -p "$(dirname "${config_file}")"
            cp "${sample}/sample/default.vcl" "${config_file}"
            ;;
        opensearch-*)
            note "${service}: copying the sample configuration, adapt it to your needs"
            mkdir -p "${config}/config"
            cp -R "${sample}/sample/." "${config}/config/"
            ;;
        *)
            note "${service}: creating empty ${config_file}"
            mkdir -p "$(dirname "${config_file}")"
            touch "${config_file}"
            ;;
    esac
}

# src/lib/settings.sh
# Loading of the dde wide (.env) and project (.env.dde) settings.

# Prints the path of the nearest .env.dde in $1 or one of its parents.
find_project_env() {
    local dir="$1"
    while [[ -n "${dir}" ]]; do
        if [[ -f "${dir}/.env.dde" ]]; then
            printf '%s\n' "${dir}/.env.dde"
            return 0
        fi
        [[ "${dir}" == "/" ]] && break
        dir="$(dirname "${dir}")"
    done
    return 0
}

load_settings() {
    # dde wide settings, see .env.sample
    if [[ ! -f "${DDE_HOME}/.env" ]]; then
        fail "${DDE_HOME}/.env is missing: copy ${DDE_HOME}/.env.sample to ${DDE_HOME}/.env and adapt it"
    fi
    set -a
    # shellcheck disable=SC1091
    . "${DDE_HOME}/.env"
    set +a
    DOCKER_COMPOSE_COMMAND="${DOCKER_COMPOSE_COMMAND:-docker compose}"

    # project settings, see .env.dde.sample
    DDE_PROJECT_ENV="$(find_project_env "${PWD}")"
    if [[ -n "${DDE_PROJECT_ENV}" ]]; then
        set -a
        # shellcheck disable=SC1090
        . "${DDE_PROJECT_ENV}"
        set +a
    fi

    local legacy
    for legacy in PHP_CLI_CONTAINER PHP_FPM_CONTAINER; do
        if [[ -n "${!legacy:-}" ]]; then
            warn "${legacy} in ${DDE_PROJECT_ENV} is no longer supported since dde 1.0, use DEFAULT_CONTAINER / DOCKER_CONTAINER"
        fi
    done
}

# :command.command_functions
# :command.function
dde_up_command() {

  # src/up_command.sh
  resolve_services
  for service in "${SERVICES[@]}"; do
      prepare_service "${service}"
  done
  up_args=(-d)
  [[ -n "${args[--build]:-}" ]] && up_args+=(--build)
  [[ -n "${args[--force-recreate]:-}" ]] && up_args+=(--force-recreate)
  compose up "${up_args[@]}" "${SERVICES[@]}"

}

# :command.function
dde_stop_command() {

  # src/stop_command.sh
  if [[ -n "${args[--all]:-}" ]]; then
      compose stop
  else
      resolve_services
      compose stop "${SERVICES[@]}"
  fi

}

# :command.function
dde_down_command() {

  # src/down_command.sh
  # never pass -v: dde down must not remove any data
  if [[ -n "${args[--all]:-}" ]]; then
      compose down
  else
      resolve_services
      compose down "${SERVICES[@]}"
  fi

}

# :command.function
dde_restart_command() {

  # src/restart_command.sh
  resolve_services
  compose restart "${SERVICES[@]}"

}

# :command.function
dde_build_command() {

  # src/build_command.sh
  build_args=()
  [[ -n "${args[--no-cache]:-}" ]] && build_args+=(--no-cache)
  [[ -n "${args[--pull]:-}" ]] && build_args+=(--pull)
  if [[ -n "${args[--all]:-}" ]]; then
      compose build "${build_args[@]}"
  else
      resolve_services
      compose build "${build_args[@]}" "${SERVICES[@]}"
  fi

}

# :command.function
dde_exec_command() {

  # src/exec_command.sh
  parse_exec_options "${other_args[@]}"
  build_run_args
  compose exec "${RUN_ARGS[@]}"

}

# :command.function
dde_run_command() {

  # src/run_command.sh
  parse_exec_options "${other_args[@]}"
  build_run_args
  compose run --rm "${RUN_ARGS[@]}"

}

# :command.function
dde_shell_command() {

  # src/shell_command.sh
  service="$(resolve_service "${args[--service]:-}")" || exit 1
  resolve_workdir_args "${service}" "${args[--workdir]:-}"
  compose exec -u "${args[--user]:-${USER_ID}}" "${WORKDIR_ARGS[@]}" "${service}" \
      sh -c 'if command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi'

}

# :command.function
dde_logs_command() {

  # src/logs_command.sh
  resolve_services
  logs_args=()
  [[ -n "${args[--follow]:-}" ]] && logs_args+=(--follow)
  [[ -n "${args[--tail]:-}" ]] && logs_args+=(--tail "${args[--tail]}")
  compose logs "${logs_args[@]}" "${SERVICES[@]}"

}

# :command.function
dde_ps_command() {

  # src/ps_command.sh
  list_containers "${args[--all]:-}"

}

# :command.function
dde_ls_command() {

  # src/ls_command.sh
  list_services "${args[filter]:-}"

}

# :command.function
dde_get_services_command() {

  # src/get_services_command.sh
  list_services "${args[filter]:-}"

}

# :command.function
dde_get_containers_command() {

  # src/get_containers_command.sh
  list_containers "${args[--all]:-}"

}

# :command.function
dde_compose_command() {

  # src/compose_command.sh
  compose "${other_args[@]}"

}

# :command.function
dde_config_command() {

  # src/config_command.sh
  service_line() {
      local name="$1" value="$2"
      printf '%-20s %s\n' "${name}" "${value:-(not set)}"
  }
  service_line "dde home" "${DDE_HOME}"
  service_line "compose file" "${DDE_COMPOSE_FILE}"
  service_line "compose command" "${DOCKER_COMPOSE_COMMAND}"
  service_line "user" "${USER_ID:-}:${GROUP_ID:-}"
  service_line "volume base path" "${DOCKER_VOLUME_BASE_PATH:-}"
  service_line "vhosts" "$(realpath "${DDE_HOME}/vhosts" 2>/dev/null)"
  service_line "project settings" "${DDE_PROJECT_ENV:-}"
  service_line "DOCKER_CONTAINER" "${DOCKER_CONTAINER:-}"
  service_line "DEFAULT_CONTAINER" "${DEFAULT_CONTAINER:-}"
  service_line "PROJECT_ROOT" "${PROJECT_ROOT:-}"
  service_line "container workdir" "$(container_workdir)"
  if [[ -n "${DOCKER_DEV_ENVIRONMENT_HOME:-}" && "$(realpath "${DOCKER_DEV_ENVIRONMENT_HOME}")" != "${DDE_HOME}" ]]; then
      warn "DOCKER_DEV_ENVIRONMENT_HOME (${DOCKER_DEV_ENVIRONMENT_HOME}) differs from the dde home, run dde init"
  fi

}

# :command.function
dde_list_command() {

  # src/list_command.sh
  # the "Commands:" section of the generated usage
  dde_usage | awk '/^Commands:/ { found = 1; next } found && /^$/ { exit } found { sub(/^  /, ""); print }'

}

# :command.function
dde_migrate_command() {

  # src/migrate_command.sh
  project="$(basename "${DDE_HOME}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')"

  mapfile -t volumes < <(docker volume ls -q --filter "label=com.docker.compose.project=${project}")
  legacy=()
  if (( ${#volumes[@]} )); then
      while read -r name option; do
          [[ "${option}" == "bind" ]] && legacy+=("${name}")
      done < <(docker volume inspect --format '{{.Name}} {{index .Options "o"}}' "${volumes[@]}")
  fi

  if (( ${#legacy[@]} == 0 )); then
      green "nothing to migrate: no dde 0.x bind volumes found"
      exit 0
  fi

  echo "dde 0.x bind volumes (the data they point to stays where it is):"
  printf '  %s\n' "${legacy[@]}"

  if [[ -z "${args[--yes]:-}" ]]; then
      read -r -p "Remove these ${#legacy[@]} volumes? [y/N] " answer
      [[ "${answer}" =~ ^[yY] ]] || { echo "aborted"; exit 1; }
  fi

  failed=0
  for volume in "${legacy[@]}"; do
      docker volume rm "${volume}" >/dev/null || failed=1
  done
  if (( failed )); then
      warn "some volumes are still used by old containers: run 'dde down --all' and 'dde migrate' again"
      exit 1
  fi
  green "removed ${#legacy[@]} volumes"

}

# :command.function
dde_version_command() {

  # src/version_command.sh
  if [[ -n "${args[--short]:-}" ]]; then
      echo "${version}"
      exit 0
  fi
  echo "dde ${version}"
  echo "compose:  $(compose version --short 2>/dev/null || echo "not available")"
  echo "home:     ${DDE_HOME}"
  echo "platform: $(uname -s) $(uname -m)"

}

# :command.function
dde_init_command() {

  # src/init_command.sh
  write_dderc
  hooked=""
  for rc_file in "${HOME}/.bashrc" "${HOME}/.zshrc"; do
      hook_rc_file "${rc_file}" && hooked=1
  done
  [[ -n "${hooked}" ]] || warn "neither ~/.bashrc nor ~/.zshrc exists, add 'source ~/.docker/.dderc' to your shell's rc file"

  if [[ ! -f "${DDE_HOME}/.env" ]]; then
      warn "${DDE_HOME}/.env is missing: copy .env.sample to .env and adapt it"
  fi
  if [[ ! -e "${DDE_HOME}/vhosts" ]]; then
      warn "${DDE_HOME}/vhosts is missing: symlink it to the directory containing your projects"
  fi

  green "dde is set up in ~/.docker/.dderc. Open a new shell or run: source ~/.docker/.dderc"

}

# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        dde_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    up | start)
      action="up"
      shift
      dde_up_parse_requirements "$@"
      shift $#
      ;;

    stop)
      action="stop"
      shift
      dde_stop_parse_requirements "$@"
      shift $#
      ;;

    down)
      action="down"
      shift
      dde_down_parse_requirements "$@"
      shift $#
      ;;

    restart)
      action="restart"
      shift
      dde_restart_parse_requirements "$@"
      shift $#
      ;;

    build)
      action="build"
      shift
      dde_build_parse_requirements "$@"
      shift $#
      ;;

    exec)
      action="exec"
      shift
      dde_exec_parse_requirements "$@"
      shift $#
      ;;

    run)
      action="run"
      shift
      dde_run_parse_requirements "$@"
      shift $#
      ;;

    shell)
      action="shell"
      shift
      dde_shell_parse_requirements "$@"
      shift $#
      ;;

    logs)
      action="logs"
      shift
      dde_logs_parse_requirements "$@"
      shift $#
      ;;

    ps)
      action="ps"
      shift
      dde_ps_parse_requirements "$@"
      shift $#
      ;;

    ls)
      action="ls"
      shift
      dde_ls_parse_requirements "$@"
      shift $#
      ;;

    get)
      action="get"
      shift
      dde_get_parse_requirements "$@"
      shift $#
      ;;

    compose)
      action="compose"
      shift
      dde_compose_parse_requirements "$@"
      shift $#
      ;;

    config)
      action="config"
      shift
      dde_config_parse_requirements "$@"
      shift $#
      ;;

    list)
      action="list"
      shift
      dde_list_parse_requirements "$@"
      shift $#
      ;;

    migrate)
      action="migrate"
      shift
      dde_migrate_parse_requirements "$@"
      shift $#
      ;;

    version)
      action="version"
      shift
      dde_version_parse_requirements "$@"
      shift $#
      ;;

    init)
      action="init"
      shift
      dde_init_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      dde_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

# :command.parse_requirements
dde_up_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        dde_up_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="up"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      # :flag.case
      --build)

        # :flag.case_no_arg
        args['--build']=1
        shift
        ;;

      # :flag.case
      --force-recreate)

        # :flag.case_no_arg
        args['--force-recreate']=1
        shift
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_repeatable
        # :argument.case_repeatable
        escaped="$(printf '%q' "$1")"
        if [[ -z ${args['service']+x} ]]; then
          args['service']="$escaped"
        else
          args['service']="${args['service']} $escaped"

        fi
        shift

        ;;

    esac
  done

}

