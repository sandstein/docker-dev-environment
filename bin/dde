# :command.usage
dde_migrate_usage() {
  if [[ -n $long_usage ]]; then
    printf "dde migrate\n\n"
    printf "  Remove the named volumes dde 0.x used for its bind mounts.\n  \n  dde 1.0 mounts config/, data/ and vhosts directly. The old volumes only\n  pointed at these directories, so removing them does not touch any data.\n  Volumes that are not bind mounts or still in use are never removed.\n\n"
  else
    printf "dde migrate - Remove the named volumes dde 0.x used for its bind mounts.\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  dde migrate [OPTIONS]\n"
  printf "  dde migrate --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "Options:"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "--yes, -y"
    printf "    Remove without asking\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

  fi
}

