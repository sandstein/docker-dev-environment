####################################################################
#
# Put this document as .env.dde in the root directory of your project
# and modify the variables. dde finds it in the current directory or
# any parent directory.
#
####################################################################

#
# which containers belong to the project (see `dde ls`)
# comma separated list, used by dde up/stop/down/restart/build/logs/ps
#
# eg. DOCKER_CONTAINER=apache-24,mysql-80,php-cli-83,php-fpm-83
#
DOCKER_CONTAINER=
#
# which container `dde exec` and `dde shell` use when no -s is given
#
# eg. DEFAULT_CONTAINER=php-cli-83
#
DEFAULT_CONTAINER=
#
# optional: project directory below vhosts used as working directory
# instead of the current directory
#
# eg. PROJECT_ROOT=my-project/src
#
# PROJECT_ROOT=
